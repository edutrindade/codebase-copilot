DB_NAME=codebase_copilot
DB_USER=copilot
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# Raiz permitida para importar pastas locais (D-018, D-029). Gera a raiz de
# key "default". Caminho absoluto de um diretório existente e legível.
# Sem raiz configurada, só o fluxo ZIP fica disponível.
PROJECTS_ROOT=
# Rótulo exibido na UI (opcional; padrão "Projetos").
# PROJECTS_ROOT_LABEL=Projetos

# Diretório de dados da aplicação (D-028). Imports ZIP são extraídos em
# DATA_DIR/imports/<importJobId>. Padrão: ~/.codebase-copilot.
# Um "~" inicial é expandido pela aplicação (user.home).
# Deve ficar fora das raízes permitidas e fora deste repositório; caso
# contrário, a aplicação não inicia.
# DATA_DIR=~/.codebase-copilot

# Provedor de embeddings (D-047): none (padrão, nada é enviado), fake (testes e
# demonstração) ou openai. Com openai, o texto dos chunks indexados e as
# perguntas de busca são enviados à OpenAI; a chave é obrigatória.
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=

# Provedor de geração das respostas (D-063): none (padrão, nada é enviado), fake
# (testes e demonstração) ou openai. Com openai, a pergunta e os trechos de código
# selecionados como evidência são enviados à OpenAI; a chave é obrigatória e pode
# ser a mesma de EMBEDDING_API_KEY.
GENERATION_PROVIDER=none
GENERATION_API_KEY=
