DB_NAME=codebase_copilot
DB_USER=copilot
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# Raiz permitida para importar pastas locais (D-018, D-029). Gera a raiz de
# key "default". Caminho absoluto de um diretório existente e legível.
# Sem raiz configurada, só o fluxo ZIP fica disponível.
PROJECTS_ROOT=
# Rótulo exibido na UI (opcional; padrão "Projetos").
# PROJECTS_ROOT_LABEL=Projetos

# Diretório de dados da aplicação (D-028). Imports ZIP são extraídos em
# DATA_DIR/imports/<importJobId>. Padrão: ~/.codebase-copilot.
# Um "~" inicial é expandido pela aplicação (user.home).
# Deve ficar fora das raízes permitidas e fora deste repositório; caso
# contrário, a aplicação não inicia.
# DATA_DIR=~/.codebase-copilot
